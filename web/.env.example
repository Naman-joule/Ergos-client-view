# App connection: the RLS-bound role through the Supabase TRANSACTION pooler (port 6543).
DATABASE_URL=postgresql://ergos_view_app.<project-ref>:CHANGE_ME@aws-0-<region>.pooler.supabase.com:6543/postgres
# Set to "disable" for a local Postgres without TLS.
DATABASE_SSL=require
# At least 32 random characters: openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
# "end" (default): meter_timestamp marks the END of the 15-minute interval. "start": the start.
METER_TS_CONVENTION=end
# Only for scripts/create-user.ts (owner connection, session pooler 5432). Never set this on Vercel.
# ADMIN_DATABASE_URL=postgresql://postgres.<project-ref>:CHANGE_ME@aws-0-<region>.pooler.supabase.com:5432/postgres

# Savings sheets (daily Excel / PDF / Word / ZIP files on ergOS's FTP server). Optional: without it the
# Savings sheets column only shows files stored as https links.
# Use a READ-ONLY FTP account limited to the reports folder, never an admin login. Prefer ftps:// if the
# server supports it. URL-encode special characters in the password (@ -> %40).
REPORTS_FTP_URL=ftp://reports_readonly:CHANGE_ME@<ftp-host>:21/
# Only files under this folder can be downloaded.
REPORTS_FTP_ROOT=/tod_savings
# If ergOS stores server-local paths (e.g. /home/ergos/ftp/reports/...), the part to strip so they match the FTP login's view.
REPORTS_FTP_STRIP_PREFIX=

# IEX Daily Obligation Reports (Obligation reports page). Admins upload PDFs; they're stored on the report FTP
# server under OBLIGATION_FTP_ROOT/<plant id>-<plant>/<YYYY>/<MM>/<MARKET>_<YYYY-MM-DD>.pdf.
# Use a SEPARATE account that can read and write only that folder (REPORTS_FTP_URL stays read-only).
# Prefer ftps:// so the password isn't sent in clear text; for a self-signed certificate put its PEM in OBLIGATION_FTP_CA.
OBLIGATION_FTP_URL=ftps://obligation-writer:CHANGE_ME@ftp.example.com:21/
OBLIGATION_FTP_ROOT=/iex_obligation
# OBLIGATION_FTP_CA=
