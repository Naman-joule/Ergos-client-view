# Read-only ergOS user
ERGOS_DATABASE_URL=postgresql://ergos_readonly:CHANGE_ME@ergos-postgres:5432/ergos
# Regulatory master DB (ToD tariffs). Use a READ-ONLY user, never super_admin. Optional.
MASTER_DATABASE_URL=postgresql://master_readonly:CHANGE_ME@<master-host>:5446/ergos_master_db
# IEX market-data DB (DAM / RTM / GDAM prices for the IEX prices page). READ-ONLY user. Optional.
IEX_DATABASE_URL=postgresql://iex_view_sync:CHANGE_ME@<iex-host>:5434/iex-data?sslmode=prefer
# Reporting DB as owner, via the Supabase SESSION pooler (port 5432).
# The direct db.<ref>.supabase.co host is IPv6-only.
TARGET_DATABASE_URL=postgresql://postgres.<project-ref>:CHANGE_ME@aws-0-<region>.pooler.supabase.com:5432/postgres
SYNC_WINDOW_DAYS=2
SYNC_STALE_MINUTES=35
